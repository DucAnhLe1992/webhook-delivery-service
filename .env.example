# Copy to .env to override the defaults.

# PostgreSQL used by the API, the worker, migrations and webhook-admin (see compose.yaml).
DATABASE_URL=postgresql+psycopg://webhooks:webhooks@localhost:5433/webhooks

# Limits on every wait on the database, in seconds. When one runs out, the API answers 503 and
# the worker logs the error and tries again, instead of waiting without end.
# Opening a connection (the driver waits at least 2 seconds).
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Waiting for a free connection from the pool.
DATABASE_POOL_TIMEOUT_SECONDS=2
# One statement, waiting for locks included.
DATABASE_STATEMENT_TIMEOUT_SECONDS=5
# Waiting for a lock that another transaction holds; migrations too. Shorter than the above.
DATABASE_LOCK_TIMEOUT_SECONDS=2
# A transaction idle between statements, before PostgreSQL ends the session and its locks.
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=10

# API: the largest request body it reads, in bytes. A larger one gets 413.
MAX_EVENT_BYTES=65536

# The only destination. Producers cannot choose where a webhook goes. Deliveries waiting for a
# retry go to the current value, so every worker needs the same one.
RECEIVER_URL=http://127.0.0.1:9000/webhooks

# Secrets the worker signs webhooks with, separated by spaces: two only while rotating. The test
# receiver checks signatures with them too. The worker does not start without one. Make one with
# `uv run webhook-admin new-webhook-secret`, and keep it in .env, which Git ignores, never here.
# WEBHOOK_SECRETS=whsec_...

# How long each network step of an attempt may take (connecting, sending, waiting for the
# status code), in seconds. It does not limit the attempt as a whole.
DELIVERY_TIMEOUT_SECONDS=5

# Worker: attempts per delivery, and the retry wait (doubles each time, up to the maximum,
# which holds even with the random variation).
MAX_ATTEMPTS=8
RETRY_BASE_DELAY_SECONDS=10
RETRY_MAX_DELAY_SECONDS=3600

# How long a claim lasts before another worker may take over. At least 3 x DELIVERY_TIMEOUT_SECONDS.
CLAIM_TIMEOUT_SECONDS=60

# How often an idle worker looks for due deliveries, in seconds.
POLL_INTERVAL_SECONDS=1

# Logs go to stderr: text, one readable line per event, or json, one object per line with fields
# such as delivery_id, request_id and outcome, for a log collector. Levels: DEBUG shows health
# checks too; INFO adds every request and attempt; WARNING keeps only problems.
LOG_FORMAT=text
LOG_LEVEL=INFO

# Prometheus metrics, on ports of their own: never on the API's port, because producers may
# reach that one and the metrics name every producer. 0 turns a process's metrics off. Several
# workers on one machine each need a port of their own. Bind to 0.0.0.0 only on a private
# network that Prometheus scrapes from.
METRICS_HOST=127.0.0.1
API_METRICS_PORT=8001
WORKER_METRICS_PORT=8002

# How long `webhook-admin purge` keeps deliveries after they were delivered or failed, in days.
# Longer than any producer retries a submission: once a delivery is deleted, its Idempotency-Key
# is free again, and a late retry would be stored and sent as a new event.
RETENTION_DAYS=30
