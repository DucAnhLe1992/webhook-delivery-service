# Copy to .env to override the defaults.

# PostgreSQL used by the API and by migrations (see compose.yaml).
DATABASE_URL=postgresql+psycopg://webhooks:webhooks@localhost:5433/webhooks

# The only destination. Producers cannot choose where a webhook goes.
RECEIVER_URL=http://127.0.0.1:9000/webhooks

# How long one attempt waits for the receiver, in seconds.
DELIVERY_TIMEOUT_SECONDS=5
